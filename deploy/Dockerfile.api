# syntax=docker/dockerfile:1

# Stage 1: Build RoleRadar.Api
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0-noble@sha256:212fe4cb74627d5adf9817a4088906ae3edff1bd853bb27565d4b46731efe61e AS build
WORKDIR /src

# Copy project files and restore with locked dependencies
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/RoleRadar.Domain/RoleRadar.Domain.csproj src/RoleRadar.Domain/packages.lock.json src/RoleRadar.Domain/
COPY src/RoleRadar.Application/RoleRadar.Application.csproj src/RoleRadar.Application/packages.lock.json src/RoleRadar.Application/
COPY src/RoleRadar.Infrastructure/RoleRadar.Infrastructure.csproj src/RoleRadar.Infrastructure/packages.lock.json src/RoleRadar.Infrastructure/
COPY src/RoleRadar.Api/RoleRadar.Api.csproj src/RoleRadar.Api/packages.lock.json src/RoleRadar.Api/

RUN dotnet restore src/RoleRadar.Api/RoleRadar.Api.csproj --locked-mode

# Copy source code and publish framework-dependent binaries
COPY src/RoleRadar.Domain/ src/RoleRadar.Domain/
COPY src/RoleRadar.Application/ src/RoleRadar.Application/
COPY src/RoleRadar.Infrastructure/ src/RoleRadar.Infrastructure/
COPY src/RoleRadar.Api/ src/RoleRadar.Api/

RUN dotnet publish src/RoleRadar.Api/RoleRadar.Api.csproj -c Release --no-restore -p:OpenApiGenerateDocumentsOnBuild=false -o /app/api

# Stage 2: Hardened Chiseled Runtime (roleradar-api)
# Note on TLS trust in chiseled runtime:
# This image has no shell and no update-ca-certificates utility. To trust a local development
# or private CA certificate for outbound OIDC backchannel HTTPS calls (e.g., https://identity:5001),
# mount the PEM certificate (whose SAN includes DNS:identity) read-only into the container
# (e.g., /https/dev-cert.crt) and set SSL_CERT_FILE=/https/dev-cert.crt.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:f2557fb81b1cfcfdfcde9d3bf247ed60b2cd38f00a88153f61e34737fab8ade7 AS api
WORKDIR /app
COPY --from=build --chown=1654:1654 /app/api /app
USER 1654:1654
ENV ASPNETCORE_URLS=http://127.0.0.1:8080 \
    DOTNET_EnableDiagnostics=0 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
    DOTNET_gcServer=0
HEALTHCHECK --interval=2s --timeout=3s --retries=5 --start-period=4s CMD ["/app/RoleRadar.Api", "--healthcheck"]
ENTRYPOINT ["/app/RoleRadar.Api"]
