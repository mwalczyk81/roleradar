# Deny by default
**

# Allow only source and required build metadata
!RoleRadar.sln
!global.json
!NuGet.Config
!Directory.Build.props
!Directory.Packages.props
!packages.lock.json
!src/**/packages.lock.json
!src/**/*.csproj
!src/**/*.cs

# Explicitly exclude sensitive directories
import-review/
private/
db/
*.rrbak
*.dump
*.sql.gz
*.env
.git/
TestResults/
bin/
obj/
dist/
