@page
@model RoleRadar.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "RoleRadar - Signed Out";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/ds/tokens.css" />
    <link rel="stylesheet" href="/ds/components/bundle.css" />
    <link rel="stylesheet" href="/css/identity.css" />
</head>
<body>
    <div class="logout-card">
        <div class="brand-lockup">
            <span class="brand">
                <svg class="brand-mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <line x1="12" y1="12" x2="18.5" y2="5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="18.5" cy="5.5" r="1.6" fill="currentColor" />
                </svg>
                <span class="brand-name">RoleRadar</span>
            </span>
        </div>
        <h1>You are signed out</h1>
        <p>Your RoleRadar session has been securely ended.</p>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <form method="post">
                <button type="submit" class="button button-danger">Sign Out</button>
            </form>
        }
        <a href="/Account/Login" class="button button-primary">Sign In Again</a>
    </div>
</body>
</html>
