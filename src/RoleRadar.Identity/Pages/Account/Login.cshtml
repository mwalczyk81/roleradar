@page
@model RoleRadar.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "RoleRadar - Owner Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/ds/tokens.css" />
    <link rel="stylesheet" href="/ds/components/bundle.css" />
    <link rel="stylesheet" href="/css/identity.css" />
</head>
<body>
    <div class="login-card">
        <div class="brand-lockup">
            <span class="brand">
                <svg class="brand-mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <line x1="12" y1="12" x2="18.5" y2="5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="18.5" cy="5.5" r="1.6" fill="currentColor" />
                </svg>
                <span class="brand-name">RoleRadar</span>
            </span>
        </div>
        <h1>Sign in</h1>

        @if (!ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 8v4M12 16h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" />
                </svg>
                <div class="alert-body">
                    @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="RequiresTwoFactor" value="@(Model.RequiresTwoFactor ? "true" : "false")" />

            @if (!Model.RequiresTwoFactor)
            {
                <div class="form-group">
                    <label asp-for="Input.Username">Username</label>
                    <input asp-for="Input.Username" autocomplete="username" autofocus />
                </div>
                <div class="form-group">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" type="password" autocomplete="current-password" />
                </div>
                <button type="submit" class="button button-primary">Sign In</button>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="TwoFactorInput.Code">6-Digit Authenticator Code</label>
                    <input asp-for="TwoFactorInput.Code" type="text" autocomplete="one-time-code" autofocus />
                </div>
                <button type="submit" class="button button-primary">Verify Code</button>
            }
        </form>
    </div>
</body>
</html>
