<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\RoleRadar.Domain\RoleRadar.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- RoleRadar.Infrastructure requires access to internal read-model properties (e.g. OwnerId, DispositionRank, HasScore)
       for BsonClassMap registration and MongoDB driver expression mapping without exposing them publicly or in OData $metadata. -->
