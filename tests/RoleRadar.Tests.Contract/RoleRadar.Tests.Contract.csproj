<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoleRadar.Domain\RoleRadar.Domain.csproj" />
    <ProjectReference Include="..\..\src\RoleRadar.Application\RoleRadar.Application.csproj" />
    <ProjectReference Include="..\..\src\RoleRadar.Infrastructure\RoleRadar.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\RoleRadar.Mcp.Stdio\RoleRadar.Mcp.Stdio.csproj" />
    <ProjectReference Include="..\..\src\RoleRadar.Identity\RoleRadar.Identity.csproj" />
    <ProjectReference Include="..\..\src\RoleRadar.Api\RoleRadar.Api.csproj" />
    <ProjectReference Include="..\..\src\RoleRadar.Observability\RoleRadar.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RoleRadar.Tests.Integration\Fixtures\MongoTestImage.cs" Link="Fixtures\MongoTestImage.cs" />
    <Compile Include="..\RoleRadar.Tests.Integration\Fixtures\FormatterLogCapture.cs" Link="Fixtures\FormatterLogCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <Target Name="CopyMcpStdioRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <McpStdioRuntimeFiles Include="..\..\src\RoleRadar.Mcp.Stdio\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(McpStdioRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
