# Default to LF line endings for cross-platform consistency
* text=auto eol=lf

# Shell and PowerShell scripts use LF
*.ps1 text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Preserve exact byte sequences (CRLF, LF, UTF-8 BOM) in test fixtures for byte-exact import tests
tests/**/fixtures/** -text
tests/fixtures/** -text
