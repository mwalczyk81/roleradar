# RoleRadar Web Development Environment Variables (.env.local template)
# Copy this file to web/.env.local and adjust values as needed.
# Note: ROLERADAR_WEB_CLIENT_SECRET must match the value exported when starting the Identity container.

NODE_ENV=development
PORT=5003
ROLERADAR_IDENTITY_ISSUER_URI=https://identity:5001
ROLERADAR_API_BASE_URL=https://localhost:5002
ROLERADAR_WEB_CLIENT_SECRET=<generate-matching-secret-see-quickstart>
SESSION_ENCRYPTION_KEY=<generate-32-byte-base64-key-see-quickstart>
NODE_EXTRA_CA_CERTS=../deploy/certs/dev-cert.crt
HTTPS_CERT_PATH=../deploy/certs/dev-cert.crt
HTTPS_CERT_KEY_PATH=../deploy/certs/dev-cert.key
