{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:server": "tsc server.ts --target es2022 --module node16 --moduleResolution node16 --outDir build/server-dist --skipLibCheck",
    "dev": "node dev.js",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "mutation": "node scripts/stryker-run.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test tests/e2e/real-stack.spec.ts --project=real-stack"
  },
  "dependencies": {
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "cookie": "1.1.1",
    "isbot": "5.2.2",
    "lucide-react": "1.66.0",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "7.18.5",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/selfsigned": "2.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "allure": "3.33.0",
    "allure-playwright": "3.14.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "30.1.3",
    "selfsigned": "5.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
